# Postgres (docker compose maps the container to host port 55432)
DATABASE_URL=postgres://sitebook:sitebook@localhost:55432/sitebook
# Integration tests only ever use this database. It must contain "test" in its name.
TEST_DATABASE_URL=postgres://sitebook:sitebook@localhost:55432/sitebook_test

# Session signing secret: at least 32 random characters (openssl rand -base64 48)
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Set to "true" when served over HTTPS (production behind a TLS proxy)
COOKIE_SECURE=false

# Where uploaded bills, challans and photos are stored
UPLOAD_DIR=./data/uploads

# AI document reader: anthropic (default) | openrouter | none
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
